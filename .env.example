APP_PORT=8080
APP_ENV=development

# Point to a local Postgres 14+ instance.
# Example after `createdb clickup`:
DB_DSN=postgres://postgres:postgres@localhost:5432/clickup?sslmode=disable

# Redis is used for rate limiting. Leave unset or unreachable to disable.
REDIS_ADDR=localhost:6379

JWT_SECRET=change-me-in-production

# 32-byte AES-256 key for the credentials vault, hex-encoded (64 chars).
# Required in production. Generate with:  openssl rand -hex 32
# In development, leave blank — a deterministic dev key is derived from
# JWT_SECRET (a warning is logged on boot). Never use the dev key in prod.
CREDENTIALS_ENCRYPTION_KEY=

# Attachments land here on disk (no S3 / no docker volume).
STORAGE_DIR=./storage

# The server auto-applies SQL files from MIGRATIONS_DIR on boot when true.
MIGRATIONS_DIR=./migrations
AUTO_MIGRATE=true

# ── Observability (Phase 1) ──────────────────────────────────────────────
# All optional — leaving them blank disables the corresponding subsystem
# and the server still boots normally.

# OpenTelemetry — set to your collector's OTLP/HTTP endpoint (e.g.
# "otel-collector:4318" or "api.honeycomb.io:443"). Leave blank to disable
# tracing entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLE_RATIO=0.1
OTEL_SERVICE_NAME=clickup-clone
OTEL_SERVICE_VERSION=dev

# Sentry — set to your Sentry DSN to enable backend error tracking. Leave
# blank to disable. The release tag is recorded so issues can be filtered
# by deploy.
SENTRY_DSN=
SENTRY_RELEASE=dev
SENTRY_SAMPLE_RATE=1.0

# ── Identity / SSO (Phase 2) ─────────────────────────────────────────────

# MFA issuer label shown in the user's authenticator app. Defaults to
# "ClickUp Clone" if unset.
MFA_ISSUER=ClickUp Clone

# OIDC — Google. To enable Sign-in-with-Google, register an OAuth 2.0
# Client ID at https://console.cloud.google.com/apis/credentials and put
# the values here. Leave blank to disable Google sign-in (the
# /auth/oidc/google endpoints will return 404).
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/google/callback

# Where to send the browser after a successful OIDC login. The session
# token is appended as `#token=...` so the SPA can pluck it from the URL
# fragment. Failures redirect to the same URL with `?error=...`.
OIDC_SUCCESS_REDIRECT=http://localhost:5173/auth/callback
OIDC_FAILURE_REDIRECT=http://localhost:5173/login

# Set to true in production (HTTPS). When false, the `oidc_state` cookie
# is sent without the Secure attribute so OIDC works on plain HTTP for
# local development.
OIDC_COOKIE_SECURE=false
